# Coneshare Environment Variables Template
#
# Copy this file to .env and fill in the values for your own custom setup.

# ------------------------------------------------------------------------------
# Core Django Settings (backend/backend/settings.py)
# ------------------------------------------------------------------------------

# REQUIRED. No default is provided on purpose; the app refuses to start without it.
# Generate with: openssl rand -hex 32   (quickstart.sh fills this in automatically)
SECRET_KEY=

# Set to "True" for local development only. Defaults to False when unset.
DEBUG=False

# The public-facing domain of the frontend. Used for generating absolute URLs.
# This value is also used to automatically configure ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS.
SITE_DOMAIN=https://localhost:8443

# IANA timezone used for user-facing notification timestamps (e.g. Asia/Shanghai).
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
DISPLAY_TIME_ZONE=UTC

# ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS are derived from SITE_DOMAIN in settings.py.
# You can uncomment and set them manually here to override this behavior.
#ALLOWED_HOSTS=127.0.0.1,localhost,backend
#CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Comma-separated list of trusted reverse proxy IP addresses or CIDR blocks for client IP resolution.
# Forwarding headers (X-Forwarded-For, X-Real-IP) will only be honoured if the
# immediate connecting peer (REMOTE_ADDR) is in this list.
# At container startup, entrypoint.py automatically synchronizes this into Nginx's real-ip.conf.
# Defaults to loopback and Docker bridge subnets ('127.0.0.1,::1,172.16.0.0/12')
# for seamless out-of-the-box operation behind a host reverse proxy (Host Nginx, Traefik, Caddy).
# NOTE: 10.0.0.0/8 and 192.168.0.0/16 are intentionally omitted by default to ensure corporate intranet
# clients cannot spoof their IP when accessing directly. If your reverse proxy or CDN runs on a separate
# subnet or host, explicitly add its IP address or CIDR range here.
#TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,192.168.1.100

# The request header that Nginx reads the client IP address from when the peer is trusted.
# Defaults to 'X-Forwarded-For'. Set to 'X-Real-IP' if your host reverse proxy only sends X-Real-IP.
#REAL_IP_HEADER=X-Forwarded-For


# ------------------------------------------------------------------------------
# Outbound requests (webhooks)
# ------------------------------------------------------------------------------
# Loopback, link-local and cloud metadata addresses are always blocked.
# Private networks (RFC 1918, CGNAT, IPv6 ULA) are blocked unless listed here as CIDRs.
# Example: OUTBOUND_ALLOWED_NETWORKS=10.20.0.0/16,192.168.50.10/32
OUTBOUND_ALLOWED_NETWORKS=

# ------------------------------------------------------------------------------
# Share-link access and /checkout
# ------------------------------------------------------------------------------
# A link that lists addresses or domains is restricted (the viewer must enter an emailed access
# code); a link with no rules is open and asks for no email. Set True for strict mode: every link
# must be restricted, whatever it lists. Signed-in owners/collaborators are always exempt.
SHARELINK_REQUIRE_ALLOWLIST=False
ACCESS_CODE_TTL_MINUTES=10
ACCESS_CODE_MAX_ATTEMPTS=5
# Code requests allowed per email / per IP in 15 minutes (per link, and for /checkout).
ACCESS_REQUESTS_PER_EMAIL=5
ACCESS_REQUESTS_PER_IP=30

# Server-side viewing protections. Restricted-pane links receive blurred pages; clear pixels
# leave the server only as small tiles around the cursor (rate limited per session and logged).
SPOTLIGHT_BLUR_RATIO=0.02
SPOTLIGHT_TILES_PER_MINUTE=600
# "Blur when not focused": pages are served only while the viewer reported focus this recently.
FOCUS_LEASE_SECONDS=15

# /checkout hard caps (a datastore's policy can only be set at or below these).
CHECKOUT_MAX_MINUTES=5
CHECKOUT_MAX_ATTEMPTS_CAP=10
CHECKOUT_ATTEMPT_WINDOW_HOURS=24
CHECKOUT_SESSION_MINUTES=30
# The e-mailed sign-in link is valid this long, once, and only for the /checkout page.
CHECKOUT_LOGIN_LINK_MINUTES=15
# A request that is approved (or auto-approved) must be opened within this many hours.
CHECKOUT_REQUEST_VALID_HOURS=24

# Maximum size of a single upload accepted by the core file service, in bytes (default 500 MiB).
#MAX_UPLOAD_BYTES=524288000

# ------------------------------------------------------------------------------
# Gunicorn Web Server Settings (backend/docker.dist/runtime/gunicorn.conf.py)
# ------------------------------------------------------------------------------
# Number of Gunicorn worker processes.
# If unset, defaults to a conservative 2 workers to avoid container memory exhaustion.
# GUNICORN_WORKERS=2
# Number of threads per worker process (default: 2).
# GUNICORN_THREADS=2

# ------------------------------------------------------------------------------
# Celery Worker Concurrency Settings
# ------------------------------------------------------------------------------
# Default concurrency for the main celery worker.
# If unset, the Docker Compose configuration defaults this value to 4.
CELERY_WORKER_CONCURRENCY=4

# ------------------------------------------------------------------------------
# Security Settings
# ------------------------------------------------------------------------------
# The minimum number of characters required for authentication password.
PASSWORD_MIN_LENGTH=8
# A comma-separated list of password validators to enable.
# Available options: similarity, min_length, common, numeric
ENABLED_PASSWORD_VALIDATORS=similarity,min_length,common,numeric

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# URL format: driver://user:password@host:port/dbname
# Example for PostgreSQL: DATABASE_URL=postgres://coneshare:password@db:5432/coneshare
# Default is SQLite for local development. The path is relative to the container.
DATABASE_URL=sqlite:////app/db.sqlite3

# ------------------------------------------------------------------------------
# Redis Settings (Cache & Celery)
# ------------------------------------------------------------------------------
# URL format: redis://:password@host:port
# This base URL is used to construct the connections for both the cache and Celery.
# The application will append /0 for Celery and /1 for the cache.
# If unset, it defaults to redis://redis:6379.
# rediss:// = TLS (default in the stack; the certificate is checked against INTERNAL_CA_FILE).
REDIS_URL=rediss://redis:6379

# ------------------------------------------------------------------------------
# Email Settings (for password resets, notifications, etc.)
# ------------------------------------------------------------------------------
# Use console backend for development to print emails to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For a real SMTP server (e.g., Gmail, SendGrid), configure the following:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
# From-address for Django's AdminEmailHandler crash emails
SERVER_EMAIL=errors@example.com
# Recipients for Django AdminEmailHandler error emails when DEBUG=False
# Format: "Name:email,Name2:email2" or "email1,email2"
ADMINS=Ops-Admin:ops@example.com

# ------------------------------------------------------------------------------
# Logging Settings
# ------------------------------------------------------------------------------
# Log level for the application. Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Service Communication (docker-compose.yml)
# ------------------------------------------------------------------------------
# REQUIRED. Shared token between backend and the core file service; no default on purpose.
# Generate with: openssl rand -hex 32   (quickstart.sh fills this in automatically)
INTERNAL_API_TOKEN=

# URL for the Go file server, as seen from the backend/celery containers.
CORE_API_URL=https://core:8080

# Port for the Go file server.
PORT=8080

# Path inside the core container where files are stored.
STORAGE_PATH=/storage

# ------------------------------------------------------------------------------
# Encryption (see docs/fork/container-security.md)
# ------------------------------------------------------------------------------
# Files at rest. "required" (default): the file service seals every stored file with AES-256-GCM and
# refuses to start without a key. "off" is an explicit, logged opt-out.
STORAGE_ENCRYPTION=required
# 64 hex characters. quickstart.sh generates it once. LOSING IT MAKES STORED FILES UNREADABLE: back it up
# somewhere other than the data volume. Generate with: openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=

# TLS between the parts. The internal CA certificate; every connection to the file service and Redis is
# verified against it (added to, not replacing, the public CAs). Empty = no internal CA configured.
# Certificates are made by scripts/gen-certs.sh, or bring your own internal CA (see the docs).
INTERNAL_CA_FILE=/certs/ca.crt

# Cookies are only sent over HTTPS (the front door is HTTPS).
AUTH_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
